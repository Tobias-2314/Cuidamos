{
  "name": "cuidamos",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:migration:new": "supabase migration new",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "test:rls": "supabase db query --local -f supabase/tests/rls_isolation.test.sql",
    "test:rls-helper": "supabase db query --local -f supabase/tests/is_family_member.test.sql",
    "test:encryption": "supabase db query --local -f supabase/tests/encryption.test.sql",
    "test:cared-persons": "supabase db query --local -f supabase/tests/cared_persons.test.sql",
    "test:cared-persons-write-rpc": "supabase db query --local -f supabase/tests/cared_persons_write_rpc.test.sql",
    "test:shifts": "supabase db query --local -f supabase/tests/shifts.test.sql",
    "test:list-family-members": "supabase db query --local -f supabase/tests/list_family_members_rpc.test.sql",
    "test:medications": "supabase db query --local -f supabase/tests/medications.test.sql",
    "test:family-invitations": "supabase db query --local -f supabase/tests/family_invitations.test.sql",
    "test:shift-handovers": "supabase db query --local -f supabase/tests/shift_handovers.test.sql",
    "test:push-tokens": "supabase db query --local -f supabase/tests/push_tokens.test.sql",
    "test:export-family-data": "supabase db query --local -f supabase/tests/export_family_data.test.sql",
    "test:delete-family-data": "supabase db query --local -f supabase/tests/delete_family_data.test.sql",
    "test:audit-events": "supabase db query --local -f supabase/tests/audit_events.test.sql",
    "test:shifts-upcoming-reminders": "supabase db query --local -f supabase/tests/shifts_upcoming_reminders.test.sql",
    "test:medications-never-logged": "supabase db query --local -f supabase/tests/medications_never_logged.test.sql",
    "test:shift-handovers-rpc": "supabase db query --local -f supabase/tests/shift_handovers_rpc.test.sql",
    "test:profiles": "supabase db query --local -f supabase/tests/profiles.test.sql",
    "test:families-creation": "supabase db query --local -f supabase/tests/families_creation.test.sql",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~51.0.0",
    "expo-dev-client": "~4.0.29",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-linking": "~6.3.1",
    "expo-notifications": "~0.28.0",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.0",
    "expo-web-browser": "~13.0.3",
    "moti": "^0.30.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "eas-cli": "^24.3.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~7.1.2",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "supabase": "^2.117.0",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
