# Entorno: LOCAL / DEV (Supabase corriendo en Docker vía `npm run db:start`)
#
# Cómo completarlo:
#   1. npm run db:start
#   2. Copiar "API URL" y "anon key" de la salida del comando (o `npm run db:status`)
#   3. cp .env.example .env   (nunca commitear .env)
#
# Solo van acá variables EXPO_PUBLIC_* (client-safe): terminan en el bundle de la app,
# así que NUNCA debe haber una service_role key ni ningún secreto real en este archivo
# ni en ningún .env que lea la app. La service_role key solo la usan scripts/CI de backend,
# nunca el cliente Expo — ver README > "Variables de entorno y secretos".

EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
